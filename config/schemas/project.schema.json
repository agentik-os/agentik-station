{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credential_references": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "environment": {
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "human_root": {
      "pattern": "^/srv/station/2_ZONES/.+/projects/",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z](?:[a-z0-9-]{0,46}[a-z0-9])?$",
      "type": "string"
    },
    "organization": {
      "pattern": "^[a-z](?:[a-z0-9-]{0,46}[a-z0-9])?$",
      "type": [
        "string",
        "null"
      ]
    },
    "repos": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "runtime_state_root": {
      "pattern": "^/var/lib/station/zones/.+/projects/",
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "zone_id": {
      "pattern": "^[a-z](?:[a-z0-9-]{0,46}[a-z0-9])?$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "zone_id",
    "environment",
    "human_root",
    "runtime_state_root",
    "repos",
    "credential_references"
  ],
  "title": "Station Project",
  "type": "object"
}
