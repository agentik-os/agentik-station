{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:station:builder:mission:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "scope", "target", "brief", "inputs", "turn_budget", "criteria", "tasks"],
  "properties": {
    "schema_version": {"const": "station-builder-mission/v1"},
    "mission_id": {"$ref": "#/$defs/id"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "host", "zone", "instance", "organization", "project", "workspace"],
      "properties": {
        "mode": {"enum": ["zone", "personal-workstation"]},
        "host": {"$ref": "#/$defs/id"}, "zone": {"$ref": "#/$defs/optionalId"},
        "instance": {"$ref": "#/$defs/id"}, "organization": {"$ref": "#/$defs/optionalId"},
        "project": {"$ref": "#/$defs/optionalId"},
        "workspace": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "/[^\u0000]+"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "os_id", "version", "package_root"],
      "properties": {
        "kind": {"const": "os-package"}, "os_id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "[0-9]+(?:\\.[0-9]+){1,3}"},
        "package_root": {"$ref": "#/$defs/path"}
      }
    },
    "brief": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "users", "constraints", "non_goals"],
      "properties": {
        "goal": {"$ref": "#/$defs/text"}, "users": {"$ref": "#/$defs/texts"},
        "constraints": {"$ref": "#/$defs/texts"}, "non_goals": {"$ref": "#/$defs/texts"}
      }
    },
    "inputs": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"enum": ["librarian", "stepper", "reference"]},
          "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "turn_budget": {"type": "integer", "minimum": 1, "maximum": 512},
    "criteria": {
      "type": "array", "minItems": 3, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "description", "kind", "verifier"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["deterministic", "independent-review", "recovery", "external"]},
          "verifier": {"$ref": "#/$defs/id"}
        }
      }
    },
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "goal", "owner", "verifier", "depends_on", "outputs", "criteria", "max_turns"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "goal": {"$ref": "#/$defs/text"},
          "owner": {"$ref": "#/$defs/id"}, "verifier": {"$ref": "#/$defs/id"},
          "depends_on": {"type": "array", "maxItems": 31, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "outputs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
          "criteria": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "max_turns": {"type": "integer", "minimum": 1, "maximum": 64}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "[a-z][a-z0-9-]*"},
    "optionalId": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "[a-z][a-z0-9-]*"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "texts": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*"},
    "hash": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
