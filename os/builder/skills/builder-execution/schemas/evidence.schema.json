{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:station:builder:evidence:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mission_sha256", "tasks"],
  "properties": {
    "schema_version": {"const": "station-builder-evidence/v1"},
    "mission_sha256": {"$ref": "#/$defs/hash"},
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "owner", "verifier", "status", "artifacts", "checks"],
        "properties": {
          "task_id": {"$ref": "#/$defs/id"}, "owner": {"$ref": "#/$defs/id"}, "verifier": {"$ref": "#/$defs/id"},
          "status": {"$ref": "#/$defs/status"},
          "artifacts": {"type": "array", "minItems": 0, "maxItems": 16, "items": {"$ref": "#/$defs/file"}},
          "checks": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["criterion_id", "status", "evidence"],
              "properties": {
                "criterion_id": {"$ref": "#/$defs/id"}, "status": {"$ref": "#/$defs/status"},
                "evidence": {"$ref": "#/$defs/file"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "[a-z][a-z0-9-]*"},
    "hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
