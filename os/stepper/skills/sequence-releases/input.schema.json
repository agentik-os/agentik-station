{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "maxLength": 48
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "activity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$",
              "maxLength": 48
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "strategy": {
            "enum": [
              "walking-skeleton",
              "end-to-end"
            ]
          },
          "acceptance_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "minItems": 1,
            "maxItems": 100
          },
          "demo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$",
              "maxLength": 48
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "outcome",
          "activity_ids",
          "strategy",
          "acceptance_checks",
          "demo",
          "dependencies"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "constraints": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "slices",
    "constraints"
  ],
  "additionalProperties": false
}
