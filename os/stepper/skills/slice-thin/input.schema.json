{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "map": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "journey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$",
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,47}$",
                      "maxLength": 48
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "status": {
                      "enum": [
                        "existing",
                        "missing"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "status"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 100
              }
            },
            "required": [
              "id",
              "label",
              "tasks"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "actor",
        "journey",
        "activities"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "map",
    "outcome"
  ],
  "additionalProperties": false
}
