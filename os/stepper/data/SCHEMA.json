{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "maxLength": 48
    },
    "artifact_type": {
      "enum": [
        "story-map",
        "slice-thin",
        "shape-bet",
        "sequence-releases"
      ]
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "verifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "schema_version",
    "mission_id",
    "artifact_type",
    "artifact_ref",
    "owner",
    "verifier"
  ],
  "additionalProperties": false
}
