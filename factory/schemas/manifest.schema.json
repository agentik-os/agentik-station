{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "os_id",
    "name",
    "version",
    "contract",
    "librarian_handoff",
    "secret_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "os_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "contract": {
      "type": "string"
    },
    "librarian_handoff": {
      "type": "string"
    },
    "secret_policy": {
      "enum": [
        "references_only"
      ]
    },
    "dependencies": {
      "type": "array"
    },
    "capabilities": {
      "type": "array"
    }
  }
}
