[Unit]
Description=Agentik Station coupled upstream discovery (agk-station; no automatic deployment)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agk-station
Group=agk-station
Environment=HOME=/home/agk-station
Environment=HERMES_HOME=/home/agk-station/.hermes
Environment=HERMES_INSTALL_DIR=/opt/station/tools/hermes/current
Environment=PATH=/home/agk-station/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/libexec/station-hermes-update auto
Nice=10
