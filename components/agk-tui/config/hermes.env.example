# Copy only the values needed by one profile to ~/.hermes/.env, then chmod 600.
# Never commit the populated file.

# Primary OpenRouter model used by the Hermes OpenRouter session adapter.
OPENROUTER_API_KEY=

# Optional Discord gateway for this profile.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOW_ALL_USERS=false
DISCORD_ALLOW_BOTS=false
DISCORD_REQUIRE_MENTION=true
DISCORD_AUTO_THREAD=true
DISCORD_HOME_CHANNEL=
DISCORD_HOME_CHANNEL_THREAD_ID=

# Optional Station guided setup broker. Both URLs must be private HTTPS
# MagicDNS names ending in .ts.net. The bot creates one-time links; it never
# accepts secrets in Discord messages.
STATION_ZONE_ID=
STATION_ZONE_STATE_ROOT=
STATION_SETUP_BASE_URL=
STATION_HERMES_SETUP_URL=

# Hermes native voice stack. One OpenAI audio key enables gpt-transcribe and
# gpt-4o-mini-tts. Keep it in this mode-0600 file or the Hermes credential pool.
OPENAI_API_KEY=
VOICE_TOOLS_OPENAI_KEY=
STT_OPENAI_MODEL=gpt-transcribe
