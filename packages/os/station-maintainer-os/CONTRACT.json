{
  "schema_version": "2.0",
  "os_id": "station-maintainer-os",
  "version": "0.6.0",
  "outcome_contract": {
    "owns": "keep_Station_compatible_secure_simple_and_current_with_Hermes",
    "mission_types": [
      "upstream_update",
      "capability_diff",
      "station_upgrade",
      "rollback",
      "recovery"
    ]
  },
  "nano_director": {
    "profile": "station-maintainer",
    "persistent_bot": true,
    "discord_identity": "dedicated"
  },
  "nanoteam": {
    "persistent_profiles": [
      "hermes-upstream-scout",
      "station-architect",
      "compatibility-engineer",
      "station-simplifier",
      "regression-engineer",
      "security-reviewer",
      "release-manager",
      "recovery-auditor"
    ],
    "kanban_workers": [],
    "ephemeral_roles": []
  },
  "profiles": [],
  "ordered_skills": [
    "upstream-check",
    "capability-diff",
    "station-architecture",
    "ponytail-simplification",
    "compatibility",
    "regression",
    "gauntlet",
    "release-rings",
    "recovery"
  ],
  "programs": [],
  "capability_contracts": [],
  "integration_adapters": [
    "hermes_native",
    "github"
  ],
  "knowledge_memory": {
    "knowledge_scopes": [],
    "memory_scopes": []
  },
  "data_model": {
    "schema": "package-defined-or-none",
    "state_model": "mission_and_domain_state",
    "migrations": "required"
  },
  "mission_model": {
    "durable_engine": "hermes_kanban",
    "root": "mission_root_task",
    "graph": "kanban_dag"
  },
  "provider_routes": {
    "policy": "model_agnostic",
    "routes": []
  },
  "workflows": [
    "hermes-upstream-upgrade",
    "station-drift-reconcile",
    "weekly-station-improvement"
  ],
  "automations": [],
  "governance": {
    "context_envelope": true,
    "capability_scoped": true,
    "approvals": "risk_based",
    "trust_zone": "station-system"
  },
  "engineering_harness": {
    "inherit_station_engineering_constitution": true
  },
  "evaluations": [
    "hermes-doctor",
    "hooks-doctor",
    "station-doctor",
    "core-os-contracts",
    "fresh-session",
    "recovery-rehearsal"
  ],
  "evidence": {
    "required": true,
    "logs": "hermes_native",
    "secret_redaction": true
  },
  "discord": {
    "mode": "dedicated",
    "face": "Operator",
    "primary_channel": "station-ops",
    "experience": {
      "plan_first": true,
      "mission_progress_card": true,
      "components": "v2-preferred",
      "final_report": true
    }
  },
  "views": [
    "fleet_health",
    "hermes_diff",
    "release_ring"
  ],
  "doctor": {
    "required": true
  },
  "update_migrations": {
    "required": true,
    "hermes_compatibility": "station_maintainer"
  },
  "rollback": {
    "required": true
  },
  "recovery": {
    "required": true
  },
  "self_improvement": {
    "learning": "hermes_native",
    "promotion": "governed",
    "may_not_weaken_hard_policy": true
  },
  "librarian": {
    "handoff": "required",
    "minimum_inputs": 15,
    "research_lanes": [
      "topic_map",
      "book_deep",
      "bestseller",
      "web_deep",
      "expert_operator_map",
      "contrarian_failure"
    ]
  },
  "deployment": {
    "fresh_session_acceptance": true,
    "automations_default": "disabled_until_accepted"
  },
  "legacy_fields_preserved": {
    "update_policy_ref": "../../06_CONFIG/hermes-update-policy.example.yaml"
  },
  "orchestration": {
    "contract": "station-orchestration/v1",
    "plan_first": true,
    "evidence_before_claims": true,
    "ownership_visible": true,
    "lanes": [
      "clarify_plan",
      "build_leverage",
      "code_ship",
      "remember_operate",
      "connect_boundaries"
    ]
  },
  "claim_evidence_policy": {
    "stages": [
      "prepared",
      "observed",
      "reported",
      "verified",
      "read_back",
      "accepted"
    ],
    "reported_is_verified": false,
    "plan_completion_is_evidence": false
  }
}
