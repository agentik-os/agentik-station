{
  "schema_version": "2.0",
  "os_id": "librarian-os",
  "version": "conversation-pack-2026.09.03+station-v8",
  "outcome_contract": {
    "owns": "produce_sourced_domain_intelligence_for_OS_builds",
    "mission_types": [
      "research_os",
      "book_deep",
      "bestseller_synthesis",
      "web_deep",
      "expert_operator_map",
      "topic_map",
      "contrarian_research",
      "research_refresh",
      "gap_research"
    ]
  },
  "nano_director": {
    "profile": "librarian-director",
    "persistent_bot": true,
    "discord_identity": "dedicated"
  },
  "nanoteam": {
    "persistent_profiles": [
      "canonical-scout",
      "modern-research-scout",
      "source-verifier",
      "principle-analyst",
      "contradiction-analyst",
      "os-mapper",
      "handoff-editor"
    ],
    "kanban_workers": [],
    "ephemeral_roles": []
  },
  "profiles": [
    "LIBRARIAN_PROFILE.md"
  ],
  "ordered_skills": [
    "query-design",
    "topic-map",
    "book-deep",
    "web-deep",
    "expert-operator-map",
    "source-discovery",
    "source-quality",
    "principle-extraction",
    "triangulation",
    "contradiction-analysis",
    "bestseller-editorial-synthesis",
    "15-best-inputs",
    "os-mapping",
    "builder-handoff",
    "knowledge-refresh",
    "copyright-integrity"
  ],
  "programs": [
    "../../programs/librarian.py"
  ],
  "capability_contracts": [
    "web/search/browser connector or approved research tools",
    "library/document connectors when scoped by mission"
  ],
  "integration_adapters": [
    "web_research",
    "document_connectors",
    "optional_composio_for_declared_research_apps"
  ],
  "knowledge_memory": {
    "knowledge_scopes": [
      "research request",
      "verified source packet",
      "domain bibliography",
      "AGK OS Contract for mapping"
    ],
    "memory_scopes": [
      "research-run state",
      "source provenance cache by allowed scope",
      "no cross-client confidential source payload leakage"
    ]
  },
  "data_model": {
    "schema": "package-defined-or-none",
    "state_model": "mission_and_domain_state",
    "migrations": "required"
  },
  "mission_model": {
    "durable_engine": "hermes_kanban",
    "root": "mission_root_task",
    "graph": "kanban_dag"
  },
  "provider_routes": {
    "policy": "model_agnostic",
    "routes": [
      "research synthesis",
      "source verification support",
      "long-context analysis; provider values are environment policy"
    ]
  },
  "workflows": [
    "research-os",
    "book-deep",
    "bestseller-synthesis",
    "web-deep",
    "expert-operator-map",
    "topic-map",
    "contrarian-research",
    "research-refresh",
    "targeted-gap-research"
  ],
  "automations": [
    "optional source refresh when domain is explicitly time-sensitive"
  ],
  "governance": {
    "context_envelope": true,
    "capability_scoped": true,
    "approvals": "risk_based",
    "trust_zone": "os-factory"
  },
  "engineering_harness": null,
  "evaluations": [
    "source provenance",
    "source diversity",
    "current-claim verification",
    "expert relevance evidence",
    "15-input non-redundancy",
    "traceability",
    "OS mapping completeness",
    "contradiction coverage",
    "copyright integrity"
  ],
  "evidence": {
    "required": true,
    "logs": "hermes_native",
    "secret_redaction": true
  },
  "discord": {
    "mode": "dedicated",
    "bot_role": "Nano Director",
    "commands": "discord/COMMANDS.yaml",
    "thread_policy": "research mission may bind a Discord thread/session; research packet and mission state remain durable outside Discord"
  },
  "views": [
    "source_map",
    "15_input_matrix"
  ],
  "doctor": {
    "required": true,
    "checks": [
      "research tool reachability",
      "research packet v2 schema",
      "provenance completeness",
      "mandatory research lanes complete or justified",
      "15 selected inputs",
      "handoff mapping completeness",
      "current claims verified where required",
      "copyright boundary"
    ]
  },
  "update_migrations": {
    "required": true,
    "hermes_compatibility": "station_maintainer"
  },
  "rollback": {
    "required": true,
    "strategy": "reactivate previous immutable research packet/handoff; never silently rewrite released source basis"
  },
  "recovery": {
    "required": true,
    "artifact": [
      "research request",
      "source packet metadata",
      "selected inputs",
      "handoff",
      "package inventory; no credentials"
    ]
  },
  "self_improvement": {
    "learning": "hermes_native",
    "promotion": "governed",
    "may_not_weaken_hard_policy": true
  },
  "librarian": {
    "self_role": "research OS",
    "builder_handoff": "14_BUILDER_HANDOFF.md",
    "selected_inputs": 15,
    "research_lanes": [
      "topic_map",
      "book_deep",
      "bestseller",
      "web_deep",
      "expert_operator_map",
      "contrarian_failure"
    ],
    "default_orchestration": "research-os"
  },
  "deployment": {
    "fresh_session_acceptance": true,
    "automations_default": "disabled_until_accepted"
  },
  "legacy_fields_preserved": {
    "station": {
      "context_envelope_required": true,
      "trust_zone": "os-factory",
      "hermes_native_first": true
    }
  },
  "orchestration": {
    "contract": "station-orchestration/v1",
    "plan_first": true,
    "evidence_before_claims": true,
    "ownership_visible": true,
    "lanes": [
      "clarify_plan",
      "research_learn",
      "remember_operate",
      "connect_boundaries"
    ]
  },
  "claim_evidence_policy": {
    "stages": [
      "prepared",
      "observed",
      "reported",
      "verified",
      "read_back",
      "accepted"
    ],
    "reported_is_verified": false,
    "plan_completion_is_evidence": false
  }
}
