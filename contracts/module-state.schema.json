{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "maturity": {
            "enum": [
              "SPECIFIED",
              "SCAFFOLDED",
              "DEGRADED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "next_repair_action"
        ]
      }
    }
  ],
  "properties": {
    "binary_probes": {
      "items": {
        "pattern": "^[a-z](?:[a-z0-9-]{0,46}[a-z0-9])?$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "claim": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z](?:[a-z0-9-]{0,46}[a-z0-9])?$",
      "type": "string"
    },
    "maturity": {
      "enum": [
        "SPECIFIED",
        "SCAFFOLDED",
        "INSTALLABLE",
        "CONFIGURED",
        "VERIFIED",
        "OPERATIONAL",
        "DEGRADED"
      ]
    },
    "next_repair_action": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "maturity",
    "claim",
    "binary_probes"
  ],
  "title": "Station module maturity",
  "type": "object"
}
