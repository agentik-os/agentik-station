{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LibrarianResearchPacketV2",
  "type": "object",
  "required": ["research_run_id", "theme", "lanes", "sources", "selected_inputs"],
  "properties": {
    "research_run_id": {"type": "string"},
    "theme": {"type": "string"},
    "lanes": {
      "type": "object",
      "required": ["book_deep", "bestseller", "web_deep", "topic_map"],
      "properties": {
        "book_deep": {"type": "object"},
        "bestseller": {"type": "object"},
        "web_deep": {"type": "object"},
        "expert_map": {"type": "object"},
        "topic_map": {"type": "object"},
        "contrarian": {"type": "object"}
      }
    },
    "sources": {"type": "array", "items": {"type": "object"}},
    "selected_inputs": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"type": "object"}}
  }
}
